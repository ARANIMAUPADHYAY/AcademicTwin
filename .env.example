# Academic Twin - Environment Variables Template
# Copy this file to .env and fill in your keys.

# =========================================================================
# 1. CORE API KEYS
# =========================================================================
# Get your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# =========================================================================
# 2. RUNTIME ENVIRONMENT CONFIGURATION
# =========================================================================
# Node environment (development or production)
NODE_ENV="production"

# The port the Express backend server should listen on.
# Platforms like Render/Railway automatically inject the PORT environment variable.
PORT=3000

# (Optional) Self-referential URL where the app is publicly hosted.
APP_URL="https://your-app-domain.onrender.com"
